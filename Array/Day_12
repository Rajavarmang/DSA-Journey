# GeeksforGeeks Problem: Missing Number in Array
class Solution:
    def missingNum(self, arr):
        # code here
        sum_=0
        Sum=0
        a=len(arr)
        for i in range(1,a+2):
            sum_=sum_ +i
        for i in range( len(arr)):
            Sum=Sum+arr[i]
        num=sum_-Sum
        return num
            
