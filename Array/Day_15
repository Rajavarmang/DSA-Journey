#Rotate a array by one
#Greek for Greek problem

class Solution:
    def rotate(self, arr):
        a=len(arr)
        for i in range(a-1,-1,-1):
            if i==a-1:
                c=arr[i]
                arr[i]=arr[i-1]
            else:
                if i==0:
                    arr[i]=c
                else:
                    arr[i]=arr[i-1]
  Example input:[1,2,3,4,5]
  Output:[5,1,2,3,4]
                
